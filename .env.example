# AI CRM V1.0 环境变量示例
# 复制为 .env 并填入真实值；.env 不得提交到版本库。所有值均为占位符。

# ── 数据库 ──────────────────────────────────────────────
POSTGRES_USER=ai_crm
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ai_crm
# 本地开发：后端跑在宿主机，连 localhost（db 容器已映射 127.0.0.1:5432）
# 容器内由 compose.yaml 的 environment 覆盖为 db:5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ai_crm:CHANGE_ME_STRONG_PASSWORD@localhost:5432/ai_crm

# ── 后端 ────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_RANDOM_64_BYTES
# 会话空闲/绝对超时（秒）
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
# CSRF / Cookie
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# 登录限流（滑动窗口）
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# 初始管理员（首次启动种子，幂等；ADMIN_INITIAL_PASSWORD 未设置则不创建）
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_MUST_CHANGE_PASSWORD=true

# ── AI Provider（可选，未配置则 AI 能力返回不可用）───────
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_MODEL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT=15

# ── 前端构建参数 ────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
